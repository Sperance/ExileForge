<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates from GitHub Releases (3.72.0): the downloaded APK goes to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:name=".ForgeApplication" android:allowBackup="false"
        android:label="Exile Forge" android:theme="@style/Theme.ExileForge"
        android:icon="@drawable/ic_forge" android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <!-- Portrait only: the layouts are made for a phone held upright (the owner's call, hence the lint warning is
             suppressed). Android 16+ ignores the lock on large screens. -->
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".update.UpdateReceiver" android:exported="false" />
    </application>
</manifest>
